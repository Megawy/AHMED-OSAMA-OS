# ============================================================
# Copy to `.env` and fill in your values. Never commit `.env`.
#   cp .env.example .env && npm run env:generate
# `src/environments/environment.{development,production}.ts` are generated
# from these values and are git-ignored.
# ============================================================

# --- Firebase web app config (Firebase console > Project settings > Your apps) ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=

# --- App metadata ---
APP_NAME=Ahmed Osama Portfolio
APP_VERSION=1.0.0
CONTACT_EMAIL=your-email@example.com
GITHUB_URL=https://github.com/YOUR_USERNAME
LINKEDIN_URL=https://linkedin.com/in/YOUR_USERNAME

# --- URLs / API endpoints ---
PORTFOLIO_URL_DEV=http://localhost:4200
PORTFOLIO_URL_PROD=https://your-domain.dev
API_BASE_URL_DEV=http://localhost:3000/api
API_BASE_URL_PROD=https://api.your-domain.dev

# --- Admin bootstrap (used by scripts/create-admin.ts and npm run seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Strong!2026
ADMIN_NAME=Admin

# Seed credentials priority: `firebase login` token (automatic) > FIREBASE_REFRESH_TOKEN > ADC.
# Optional overrides:
# FIREBASE_REFRESH_TOKEN=<from `firebase login:ci`>
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
