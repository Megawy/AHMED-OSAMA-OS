rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.token.email)).data.active == true;
    }

    // ============================================================
    // Public folders - anyone can read
    // ============================================================

    match /projects/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /general/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /avatars/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ============================================================
    // All other paths - admin only
    // ============================================================

    match /{allPaths=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
