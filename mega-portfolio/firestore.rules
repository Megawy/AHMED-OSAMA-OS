rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isAdminActive() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true;
    }

    // ============================================================
    // Public read collections
    // ============================================================

    // Projects - public read, admin write
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // Technologies - public read, admin write
    match /technologies/{techId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // Skills - public read, admin write
    match /skills/{skillId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // Experience - public read, admin write
    match /experience/{expId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // Settings - public read, admin write
    match /settings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // ============================================================
    // Messages - public create (contact form), admin read/write
    // ============================================================

    match /messages/{messageId} {
      allow read: if isAdminActive();
      allow create: if true
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.email.matches('.*@.*\\..+');
      allow update, delete: if isAdminActive();
    }

    // ============================================================
    // Media - admin only
    // ============================================================

    match /media/{mediaId} {
      allow read, create, update, delete: if isAdminActive();
    }

    // ============================================================
    // Analytics - public read counters, admin write
    // ============================================================

    match /analytics/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    // ============================================================
    // Admins - admin only (self-verification)
    // ============================================================

    match /admins/{adminEmail} {
      allow read: if isAuthenticated()
        && adminEmail == request.auth.token.email;
      allow create, update, delete: if isAdminActive();
    }

    // ============================================================
    // Deny everything else
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
