{
  "name": "mega-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:generate": "tsx scripts/generate-env.ts",
    "prestart": "npm run env:generate",
    "start": "ng serve",
    "prebuild": "npm run env:generate",
    "build": "ng build",
    "prewatch": "npm run env:generate",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run env:generate",
    "test": "ng test",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/create-demo-data.ts",
    "seed:emulator": "tsx scripts/seed.ts --emulator",
    "seed:update": "tsx scripts/seed.ts --update",
    "reset-db": "tsx scripts/reset.ts --force",
    "provision-storage": "node scripts/provision-storage.cjs",
    "create-admin": "tsx scripts/create-admin.ts",
    "emulator": "firebase emulators:start",
    "deploy-db": "firebase deploy --only firestore,storage",
    "deploy-hosting": "firebase deploy --only hosting",
    "deploy-all": "npm run build && firebase deploy --only firestore,hosting",
    "serve:ssr:mega-portfolio": "node dist/mega-portfolio/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.9",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "express": "^5.1.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.6.0",
    "gsap": "^3.15.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@google-cloud/firestore": "^8.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "firebase-tools": "^14.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.20",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
